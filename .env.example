# Use demo until real provider adapters are enabled.
LLM_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional alternative provider, wired later.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=

# Web research.
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5

# LangSmith tracing.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=deepinsight-agent

# Local checkpoint database.
CHECKPOINT_DB_PATH=data/checkpoints/deepinsight.sqlite

# MySQL persistence. Keep MYSQL_PASSWORD only in .env, never in Git.
MYSQL_ENABLED=false
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=deepinsight_agent
